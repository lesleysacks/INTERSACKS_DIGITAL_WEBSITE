# Never commit real credentials. Add these values in Netlify: Site configuration > Environment variables.
SITE_URL=https://your-site.netlify.app

# PayFast
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_MODE=sandbox

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Website enquiries. Set these on the enquiry proxy host, never in frontend code.
# APPS_SCRIPT_ENQUIRY_URL is the Apps Script web app /exec URL.
# ENQUIRY_PROXY_TOKEN is the HMAC key. It must match the Apps Script property
# ENQUIRY_PROXY_TOKEN. The proxy signs each request; the raw token is not sent.
APPS_SCRIPT_ENQUIRY_URL=https://script.google.com/macros/s/your_deployment_id/exec
ENQUIRY_PROXY_TOKEN=replace-with-a-long-random-string
ENQUIRY_ALLOWED_ORIGINS=https://www.intersacks.co.za,https://intersacks.co.za
# Milliseconds to wait for Apps Script before aborting. Default 15000. Clamped to 1000–30000.
ENQUIRY_UPSTREAM_TIMEOUT_MS=15000
# In-memory limits for this Node process only. They reset on restart and are not shared across instances.
ENQUIRY_RATE_LIMIT=8
ENQUIRY_RATE_WINDOW_MS=600000
ENQUIRY_GLOBAL_RATE_LIMIT=60
ENQUIRY_GLOBAL_RATE_WINDOW_MS=60000
